.DS_Store

# Fetch-time intermediate upstream payloads.
# Keep the directory skeleton in git, but do not track fetched copies.
sources/*
!sources/.gitkeep
!sources/README.md
!sources/adguard-japanese/
!sources/easylist/
!sources/ublock-origin/
!sources/adguard-japanese/.gitkeep
!sources/easylist/.gitkeep
!sources/ublock-origin/.gitkeep
!sources/ublock-origin/raw/
!sources/ublock-origin/flat/
!sources/ublock-origin/raw/.gitkeep
!sources/ublock-origin/flat/.gitkeep
